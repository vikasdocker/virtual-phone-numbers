# Local demo: npm ci && npm run dev, then open http://127.0.0.1:5173
NODE_ENV=development
APP_MODE=demo
# Hosted free preview uses APP_MODE=preview and requires an HTTPS APP_URL.
# It never enables real sales or persists customer data.
APP_URL=http://127.0.0.1:5173
PORT=3000
DATABASE_PATH=data/linea.db
TRUST_PROXY=0

# Production: copy to .env on the SERVER; never commit credentials.
# NODE_ENV=production
# APP_MODE=live
# APP_URL=https://numbers.your-domain.com
# DOMAIN=numbers.your-domain.com
# TRUST_PROXY=1
# DATABASE_PATH=/app/data/linea.db
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SUPPORT_EMAIL=support@example.com
OPERATOR_NAME=
OPERATOR_ADDRESS=
LEGAL_REVIEWED=false
# Enable only after business/legal review and a successful end-to-end payment test.
SALES_ENABLED=false
# Merchant retail rental prices in USD cents, not Twilio supplier prices.
PRICE_US_CENTS=300
PRICE_CA_CENTS=400
MESSAGE_RETENTION_DAYS=30
